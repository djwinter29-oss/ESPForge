@@ -148,6 +148,18 @@ static int esp32_pin_apply_config(uint32_t pin, uint32_t flags)
 			gpio_ll_od_disable(gpio_base, io_pin);
 		}
 
+		if (drive != 0) {
+			gpio_drive_cap_t cap = (gpio_drive_cap_t)(drive - 1);
+
+			if (!rtc_gpio_is_valid_gpio(io_pin) || SOC_GPIO_SUPPORT_RTC_INDEPENDENT) {
+				gpio_ll_set_drive_capability(&GPIO, io_pin, cap);
+			} else {
+#if SOC_RTCIO_INPUT_OUTPUT_SUPPORTED
+				rtcio_hal_set_drive_capability(rtc_io_num_map[io_pin], cap);
+#endif
+			}
+		}
