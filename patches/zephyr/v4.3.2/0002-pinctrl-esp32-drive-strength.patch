@@ -74,7 +74,7 @@ static inline bool esp32_pin_is_output_capable(uint32_t pin)
 	return ((BIT(pin) & SOC_GPIO_VALID_OUTPUT_GPIO_MASK) != 0);
 }
 
-static int esp32_pin_apply_config(uint32_t pin, uint32_t flags)
