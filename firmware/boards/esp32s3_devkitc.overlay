#include <zephyr/dt-bindings/gpio/gpio.h>

/* Native USB OTG on the DevKitC USB connector (GPIO19 D-, GPIO20 D+). */
&usb_otg {
	status = "okay";
	espforge_hid: hid_dev_0 {
		compatible = "zephyr,hid-device";
		label = "ESPForge";
		protocol-code = "none";
		in-report-size = <64>;
		in-polling-period-us = <4000>;
	};
};

&coretemp {
	status = "okay";
};

&spi2 {
	status = "okay";
	cs-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
	espforge_sd: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <10000000>;
		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

/* SPI3's default pins overlap some modules' internal flash/PSRAM signals. */
&spi3 {
	status = "disabled";
};
