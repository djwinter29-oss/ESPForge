#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/esp32s3-pinctrl.h>

/*
 * ESP32-S3-DevKitC-1 N16R8 (ESP32-S3-WROOM-1-N16R8): 16 MB quad flash and 8 MB octal PSRAM.
 * The upstream board DTS describes the N8 module with the 4 MB partition table, so replace both.
 */
&flash0 {
	reg = <0x0 DT_SIZE_M(16)>;
	/delete-node/ partitions;
};

#include <espressif/partitions_0x0_amp_16M.dtsi>

&psram0 {
	size = <DT_SIZE_M(8)>;
};

/* Native USB OTG on the DevKitC USB connector (GPIO19 D-, GPIO20 D+). */
&usb_otg {
	status = "okay";
	espforge_hid: hid_dev_0 {
		compatible = "zephyr,hid-device";
		label = "ESPForge";
		protocol-code = "none";
		in-report-size = <64>;
		in-polling-period-us = <4000>;
	};
};

&coretemp {
	status = "okay";
};

&pinctrl {
	espforge_sd_default: espforge_sd_default {
		clock {
			pinmux = <SDHC0_CLKOUT_GPIO12>;
		};
		command_data {
			pinmux = <SDHC0_CMD_GPIO11>, <SDHC0_DATA0_GPIO13>,
				 <SDHC0_DATA1_GPIO14>, <SDHC0_DATA2_GPIO15>, <SDHC0_DATA3_GPIO10>;
			bias-pull-up;
		};
	};
};

&sdhc {
	status = "okay";
};

espforge_sd: &sdhc0 {
	status = "okay";
	pinctrl-0 = <&espforge_sd_default>;
	pinctrl-names = "default";
	bus-width = <4>;
	max-bus-freq = <25000000>;
	mmc {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
		status = "okay";
	};
};

&spi2 {
	status = "disabled";
};

/* SPI3's default pins overlap the module's internal flash/PSRAM signals (octal PSRAM uses GPIO33-37). */
&spi3 {
	status = "disabled";
};
