#include "esp32s3_devkitc.overlay"

/ {
	aliases {
		espforge-sd = &espforge_sd_spi;
	};
};

&sdhc {
	status = "disabled";
};

&sdhc0 {
	status = "disabled";
	mmc {
		status = "disabled";
	};
};

&pinctrl {
	espforge_sd_spi_default: espforge_sd_spi_default {
		clock {
			pinmux = <SPIM3_SCLK_GPIO12>;
		};
		data {
			pinmux = <SPIM3_MOSI_GPIO11>, <SPIM3_MISO_GPIO13>;
			bias-pull-up;
		};
	};
};

/* Override all default SPI3 pins to avoid the module's internal flash/PSRAM signals. */
&spi3 {
	status = "okay";
	pinctrl-0 = <&espforge_sd_spi_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
	espforge_sd_spi: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		spi-max-frequency = <25000000>;
		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};
